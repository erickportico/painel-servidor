                        '    <table class="tab-lanc">' +
                        '      <thead><tr><th style="width:46%;">Data</th><th style="width:34%;">Qtd instalada</th><th style="width:20%;"></th></tr></thead>' +
                        '      <tbody id="lancTbody"></tbody>' +
