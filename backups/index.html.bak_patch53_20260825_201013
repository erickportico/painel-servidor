                function updateCronoTaskStart(index, val) {
                  if (!val) return;
                  tasks[index].start = val;
                  saveCronoStorage();
                  renderCronoTasks();
                }
            
                function updateCronoTaskEnd(index, val) {
                  if (!val) return;
                  tasks[index].end = val;
                  saveCronoStorage();
                  renderCronoTasks();
                }
            
