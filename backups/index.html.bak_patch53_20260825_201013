                  tasks.forEach(t => {
                    let dStart = new Date(t.start + "T00:00:00");
                    let dEnd = new Date((t.actualEnd || t.end) + "T00:00:00");
            
                    if (dStart < minDate) minDate = dStart;
                    if (dEnd > maxDate) maxDate = dEnd;
