                        URL.revokeObjectURL(url);
                    };
                    // ---- DXF ENTITIES-ONLY (with offset + TEXT metadata) ----
                    function generateDXFEntitiesCTM(ref, type, L, H, profW, hasBottom, scope, offsetX, offsetY){
                        offsetX = offsetX || 0;
                        offsetY = offsetY || 0;
                        var lines = [];
                        // Outer frame
                        lines.push('0'); lines.push('LINE');
                        lines.push('8'); lines.push('CTM_OUTER');
                        lines.push('10'); lines.push(offsetX.toString()); lines.push('20'); lines.push(offsetY.toString());
                        lines.push('11'); lines.push((offsetX + L).toString()); lines.push('21'); lines.push(offsetY.toString());
                        lines.push('0'); lines.push('LINE');
                        lines.push('8'); lines.push('CTM_OUTER');
                        lines.push('10'); lines.push((offsetX + L).toString()); lines.push('20'); lines.push(offsetY.toString());
                        lines.push('11'); lines.push((offsetX + L).toString()); lines.push('21'); lines.push((offsetY + H).toString());
                        lines.push('0'); lines.push('LINE');
                        lines.push('8'); lines.push('CTM_OUTER');
                        lines.push('10'); lines.push((offsetX + L).toString()); lines.push('20'); lines.push((offsetY + H).toString());
                        lines.push('11'); lines.push(offsetX.toString()); lines.push('21'); lines.push((offsetY + H).toString());
                        lines.push('0'); lines.push('LINE');
                        lines.push('8'); lines.push('CTM_OUTER');
                        lines.push('10'); lines.push(offsetX.toString()); lines.push('20'); lines.push((offsetY + H).toString());
                        lines.push('11'); lines.push(offsetX.toString()); lines.push('21'); lines.push(offsetY.toString());
                        // Inner frame
                        var pw = profW;
                        var iL = L - 2 * pw, iH = hasBottom ? H - 2 * pw : H - pw;
                        if(iL > 0 && iH > 0){
                            lines.push('0'); lines.push('LINE');
                            lines.push('8'); lines.push('CTM_INNER');
                            lines.push('10'); lines.push((offsetX + pw).toString()); lines.push('20'); lines.push((offsetY + pw).toString());
                            lines.push('11'); lines.push((offsetX + pw + iL).toString()); lines.push('21'); lines.push((offsetY + pw).toString());
                            lines.push('0'); lines.push('LINE');
                            lines.push('8'); lines.push('CTM_INNER');
                            lines.push('10'); lines.push((offsetX + pw + iL).toString()); lines.push('20'); lines.push((offsetY + pw).toString());
                            lines.push('11'); lines.push((offsetX + pw + iL).toString()); lines.push('21'); lines.push((offsetY + pw + iH).toString());
                            lines.push('0'); lines.push('LINE');
                            lines.push('8'); lines.push('CTM_INNER');
                            lines.push('10'); lines.push((offsetX + pw + iL).toString()); lines.push('20'); lines.push((offsetY + pw + iH).toString());
                            lines.push('11'); lines.push((offsetX + pw).toString()); lines.push('21'); lines.push((offsetY + pw + iH).toString());
                            lines.push('0'); lines.push('LINE');
                            lines.push('8'); lines.push('CTM_INNER');
                            lines.push('10'); lines.push((offsetX + pw).toString()); lines.push('20'); lines.push((offsetY + pw + iH).toString());
                            lines.push('11'); lines.push((offsetX + pw).toString()); lines.push('21'); lines.push((offsetY + pw).toString());
                        }
                        // --- TEXT entities (CTM metadata) ---
                        var txtH = H * 0.04;
                        var txtLayer = "CTM_LABELS";
                        var lblX = offsetX - H * 0.35;
                        var rowGap = txtH * 2.2;
                        var topY = offsetY + H;
                        // REF
                        lines.push('0'); lines.push('TEXT');
                        lines.push('8'); lines.push(txtLayer);
                        lines.push('10'); lines.push(lblX.toString()); lines.push('20'); lines.push(topY.toString());
                        lines.push('40'); lines.push(txtH.toString());
                        lines.push('1'); lines.push('REF: ' + ref);
                        // TIPO
                        lines.push('0'); lines.push('TEXT');
                        lines.push('8'); lines.push(txtLayer);
                        lines.push('10'); lines.push(lblX.toString()); lines.push('20'); lines.push((topY - rowGap).toString());
                        lines.push('40'); lines.push(txtH.toString());
                        lines.push('1'); lines.push('TIPO: ' + type);
                        // ESTRUTURA
                        var estrutura = hasBottom ? "4 LADOS" : "3 LADOS";
                        lines.push('0'); lines.push('TEXT');
                        lines.push('8'); lines.push(txtLayer);
                        lines.push('10'); lines.push(lblX.toString()); lines.push('20'); lines.push((topY - 2 * rowGap).toString());
                        lines.push('40'); lines.push(txtH.toString());
                        lines.push('1'); lines.push('ESTRUTURA: ' + estrutura);
                        // MODELO CTM
                        var modelo = profW === 20 ? "ESTREITO (20mm)" : "LARGO (33mm)";
                        lines.push('0'); lines.push('TEXT');
                        lines.push('8'); lines.push(txtLayer);
                        lines.push('10'); lines.push(lblX.toString()); lines.push('20'); lines.push((topY - 3 * rowGap).toString());
                        lines.push('40'); lines.push(txtH.toString());
                        lines.push('1'); lines.push('MODELO CTM: ' + modelo);
                        // H label
                        lines.push('0'); lines.push('TEXT');
                        lines.push('8'); lines.push(txtLayer);
                        lines.push('10'); lines.push((offsetX - H * 0.15).toString()); lines.push('20'); lines.push((offsetY + H / 2).toString());
                        lines.push('40'); lines.push(txtH.toString());
                        lines.push('1'); lines.push('H=' + H);
                        // L label
                        lines.push('0'); lines.push('TEXT');
                        lines.push('8'); lines.push(txtLayer);
                        lines.push('10'); lines.push((offsetX + L / 2).toString()); lines.push('20'); lines.push((offsetY - txtH * 1.5).toString());
                        lines.push('40'); lines.push(txtH.toString());
                        lines.push('1'); lines.push('L=' + L);
                        return lines;
                    }
                
                    // ---- DXF FULL FILE (single item) ----
                    function generateDXFContentCTM(ref, type, L, H, profW, hasBottom, scope){
                        var headerLines = [];
                        headerLines.push('0'); headerLines.push('SECTION');
                        headerLines.push('2'); headerLines.push('HEADER');
                        headerLines.push('0'); headerLines.push('ENDSEC');
                        headerLines.push('0'); headerLines.push('SECTION');
                        headerLines.push('2'); headerLines.push('ENTITIES');
                        var entityLines = generateDXFEntitiesCTM(ref, type, L, H, profW, hasBottom, scope, 0, 0);
                        var footerLines = [];
                        footerLines.push('0'); footerLines.push('ENDSEC');
                        footerLines.push('0'); footerLines.push('EOF');
                        return headerLines.concat(entityLines, footerLines).join('\n');
                    }
                
                    // ---- DXF EXPORT (BATCH) - single valid DXF with merged entities ----
                    window.downloadBatchDXFCTM = function(){
                        var chks = document.querySelectorAll('.cad-batch-chk:checked');
                        if(chks.length === 0){ alert('Selecione itens.'); return; }
                        var specs = getCTMSpecs();
                        var mType = document.getElementById('batchCadMeasureType').value;
                        var allLines = [];
                        // Single HEADER section
                        allLines.push('0'); allLines.push('SECTION');
                        allLines.push('2'); allLines.push('HEADER');
                        allLines.push('0'); allLines.push('ENDSEC');
                        allLines.push('0'); allLines.push('SECTION');
                        allLines.push('2'); allLines.push('ENTITIES');
                        // Smart auto-layout offsets
                        var cursorX = 0;
                        var cursorY = 0;
                        var maxRowH = 0;
                        var gapX = 800;
                        var gapY = 800;
                        var colLimit = 6000;
                        var col = 0;
                        chks.forEach(function(chk, idx){
                            var ref = chk.getAttribute('data-ref');
                            var spec = specs.find(function(s){ return s.ref === ref; });
                            if(!spec) return;
                            var pL = spec.L, pH = spec.H;
                            if(mType === 'fora'){ pL += 28; pH += 28; } else if(mType === 'dentro'){ pL -= 4; pH -= 4; }
                            var profW = spec.ctmProfile === 'estreito' ? 20 : 33;
                            // Auto-layout: wrap columns if exceeding limit
                            if(cursorX + pL + 400 > colLimit && col > 0){
                                cursorX = 0;
                                cursorY -= (maxRowH + gapY);
                                maxRowH = 0;
                                col = 0;
                            }
                            allLines.push('0'); allLines.push('COMMENT'); allLines.push('1'); allLines.push('--- CTM: ' + ref + ' ---');
                            var entityLines = generateDXFEntitiesCTM(ref, spec.type, pL, pH, profW, spec.hasBottom, 'full', cursorX, cursorY);
                            for(var e = 0; e < entityLines.length; e++) allLines.push(entityLines[e]);
                            cursorX += (pL + gapX);
                            if(pH > maxRowH) maxRowH = pH;
                            col++;
                        });
                        // Single ENDSEC + EOF
                        allLines.push('0'); allLines.push('ENDSEC');
                        allLines.push('0'); allLines.push('EOF');
                        var dxfStr = allLines.join('\n');
                        var blob = new Blob([dxfStr], {type: 'application/dxf'});
                        var url = URL.createObjectURL(blob);
                        var a = document.createElement('a'); a.href = url; a.download = 'CTM_Batch.dxf'; a.click();
                        URL.revokeObjectURL(url);
                    };
                
