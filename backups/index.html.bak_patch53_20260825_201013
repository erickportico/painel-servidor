                                    title: { display: true, text: 'm² acumulado', color: textColor },
                                    ticks: { color: textColor }, grid: { display: false }
                                },
                                x: { ticks: { color: textColor, maxRotation: 60, minRotation: 0, font: { size: 9 } }, grid: { display: false } }
                            }
                        }
                    });
                }
