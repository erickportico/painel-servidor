              _confirmPgtoCb = cb;
              document.getElementById('modalConfirmPgto').style.display = 'flex';
            }
            function executarConfirmPgto() {
              document.getElementById('modalConfirmPgto').style.display = 'none';
              if (_confirmPgtoCb) _confirmPgtoCb();
